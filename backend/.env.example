# Server
NODE_ENV=development
PORT=4000

# CORS
# Comma-separated allowed origins for future CRM frontend and public web.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
# Use a Neon PostgreSQL connection string when backend development starts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
# Use long random values in real environments.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin seed
# Set these only in local/private environments before running npm run seed:admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
ADMIN_NAME="NexoDigital Admin"
ADMIN_ROLE=ADMIN
