# Server
NODE_ENV=development
PORT=4000

# CORS
# Comma-separated allowed origins for the future CRM frontend and local tools.
# Production on Railway must set the real Hostinger domain that serves the
# public web and /crm/* panel, for example:
# CORS_ORIGIN=https://nexo-digital.tech,https://www.nexo-digital.tech
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Database
# Use the existing Neon PostgreSQL connection string.
# In Railway, DATABASE_URL must point to Neon. Do not create another database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
# Use long random values in real environments.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin seed
# Set these only in local/private environments before running npm run seed:admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
ADMIN_NAME="NexoDigital Admin"
ADMIN_ROLE=ADMIN
